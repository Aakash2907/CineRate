# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string (Supabase, Neon, or Cloud SQL)
# Example: postgresql://postgres:yourpassword@db.xyz.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/cinerate"

# Optional granular PostgreSQL settings (if not using DATABASE_URL):
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="cinerate"
PGUSER="postgres"
PGPASSWORD="password"
PGSSL="false"

# JWT_SECRET: Secret key for signing HTTP-only authentication tokens
JWT_SECRET="cinerate_super_secure_jwt_secret_key_2026_change_in_production"

# PORT: Server port (default 3000)
PORT="3000"

# NODE_ENV
NODE_ENV="development"

